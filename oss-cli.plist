<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template. Replace /ABSOLUTE/PATH/TO/oss-cli with wherever you cloned
    this repository, then install it:

        cp oss-cli.plist ~/Library/LaunchAgents/com.osscli.plist
        launchctl load ~/Library/LaunchAgents/com.osscli.plist

    launchd requires absolute paths — ~ and environment variables are not
    expanded here, so the substitution above is not optional.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.osscli</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/oss-cli/oss-cli-master.sh</string>
    </array>

    <!-- Run every 1 hour (3600 seconds) -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Run once immediately as soon as you turn on or wake up your Mac -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logging paths -->
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/oss-cli/oss-cli_run.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/oss-cli/oss-cli_run.log</string>
</dict>
</plist>
