<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.osscli</groupId>
    <artifactId>oss-cli</artifactId>
    <version>1.11.9</version>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Stamped into version.properties and reported by the version option. -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    </properties>

    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.21.5</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.26.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.26.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.26.1</version>
        </dependency>

        <!--
            The queue behind the asynchronous file appender.

            Conversant's DisruptorBlockingQueue rather than the default
            ArrayBlockingQueue: a lock-free ring buffer, which is the point of
            making the appender asynchronous at all. Only the FILE appender is
            asynchronous; see log4j2.xml for why the console must not be.
        -->
        <dependency>
            <groupId>com.conversantmedia</groupId>
            <artifactId>disruptor</artifactId>
            <version>1.2.21</version>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.22.0</version>
        </dependency>

        <!--
            Tests. There were none, which is how a fresh database came to be stamped at the current
            schema version while missing three tables, with nothing to notice.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
                Only version.properties is filtered. log4j2.xml carries ${sys:...} lookups that
                Maven would resolve at build time, baking one machine's paths into the jar.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!--
                        Tests that touch the database must never find the real one.

                        This MUST be the environment variable. AppPaths.resolveBaseDir reads
                        OSS_CLI_HOME and nothing else; oss.cli.home is written BY the application
                        for log4j2.xml to read back, and setting it here redirects nothing at all.
                        That mistake was made once, and SchemaTest deleted a real 496 MB database
                        with it. A redirection that silently does nothing is worse than none,
                        because the test then passes while destroying the thing it was protecting.
                    -->
                    <environmentVariables>
                        <OSS_CLI_HOME>${project.build.directory}/test-home</OSS_CLI_HOME>
                        <!--
                            A token-shaped string that is not a token, so tests reach the code
                            they are testing.

                            Without it, anything that builds a GitHubClient stops at
                            CredentialManager instead. OfflineBehaviourTest passed on a developer
                            machine and failed in CI for exactly that reason: locally it reached
                            the socket and asserted on the offline message, and in CI it never
                            got past "GitHub Token is missing". A test whose result depends on
                            whether the machine happens to be logged in is testing the machine.

                            Nothing here may use it against the real API: the API base is pointed
                            at a host that does not resolve wherever that matters.
                        -->
                        <GITHUB_TOKEN>not-a-real-token-for-tests</GITHUB_TOKEN>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <!--
                            And with a token now present, nothing may reach the real API. This
                            is the paired half: api.invalid is reserved by RFC 2606 to never
                            resolve, so the whole suite is offline by construction rather than
                            by every test remembering to be.
                        -->
                        <oss.github.api>https://api.invalid</oss.github.api>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.9.0</version>
                <configuration>
                    <java>
                        <!-- Uses Palantir's Java format (a very clean, standard 4-space indent style) -->
                        <palantirJavaFormat/>

                        <!-- Automatically removes unused imports -->
                        <removeUnusedImports/>

                        <!-- Ensures files end with a new line -->
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <!-- Automatically check formatting during the verify phase -->
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- SHADE PLUGIN: Creates the perfect Fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Debug symbols for the ONNX native libraries: 138 MB of
                                             DWARF that is never read at runtime and took the jar
                                             from 19 MB to 154 MB. Excluding these keeps EVERY
                                             platform's library, so the build stays one artifact
                                             that runs anywhere. -->
                                        <exclude>**/*.dSYM/**</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.osscli.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>